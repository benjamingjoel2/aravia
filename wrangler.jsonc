// Cloudflare config for the OpenNext build (`npm run cf-build` / `npm run cf-pages`).
// The site is deployed as a Git-connected Cloudflare Pages project; see scripts/cf-pages.mjs.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aravia",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference used by OpenNext's cache layer; must match "name".
    { "binding": "WORKER_SELF_REFERENCE", "service": "aravia" }
  ]
}
